# Site
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Chain (Base mainnet)
NEXT_PUBLIC_CHAIN_ID=8453

# Deployed CheckIn.sol on Base — required for Daily check-in
NEXT_PUBLIC_CHECK_IN_CONTRACT_ADDRESS=0x0A138315a532B294da09Df49C2C1861a8a996D35

# Base.dev project — Settings → App ID for meta tag
NEXT_PUBLIC_BASE_APP_ID=

# Builder Code from base.dev — Settings → Builder Code (e.g. bc_…)
NEXT_PUBLIC_BUILDER_CODE=

# Optional: raw ERC-8021 hex suffix instead of generating from BUILDER_CODE
# NEXT_PUBLIC_BUILDER_CODE_SUFFIX=0x

# Optional WalletConnect (leave empty to hide WC in connector list)
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
